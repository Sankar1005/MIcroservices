{
  // YARP configuration: Routes decide WHICH requests match, Clusters decide WHERE they go.
  // Adding a service = one route + one cluster here. No code change, no frontend change.
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": { "Path": "/api/products/{**catch-all}" },
        // The gateway handles CORS for browsers, so the services behind it never see the Origin header.
        "Transforms": [ { "RequestHeaderRemove": "Origin" } ]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "Transforms": [ { "RequestHeaderRemove": "Origin" } ]
      }
    },
    "Clusters": {
      "products-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "product-service": { "Address": "http://localhost:5101/" }
        }
      },
      "orders-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "order-service": { "Address": "http://localhost:5102/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}
